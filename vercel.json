{
    "version": 2,
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/(.*\\.(?:css|js|mjs|map|woff|woff2|ttf|eot|otf|png|jpe?g|gif|svg|ico|webp|avif|txt|json))$",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
